# ─────────────────────────────────────────
# Configuration du projet PFA 2025-2026
# Copiez ce fichier en .env et remplissez les valeurs
# ─────────────────────────────────────────

# Versions ELK
ELK_VERSION=8.12.0

# Ports
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
LOGSTASH_PORT=5044
AUTH_SERVICE_PORT=5001
API_SERVICE_PORT=5002
FRONTEND_PORT=3000

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX=security-logs

# Passwords
GRAFANA_ADMIN_PASSWORD=changeme
DEMO_ADMIN_PASSWORD=changeme
DEMO_USER1_PASSWORD=changeme
DEMO_OPERATOR_PASSWORD=changeme
